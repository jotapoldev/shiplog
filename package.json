    "task:status": "node --env-file-if-exists=.env.local scripts/shiplog.ts status",
    "demo": "node scripts/demo.ts",
    "docker": "docker compose --env-file .env.local up -d --build",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
